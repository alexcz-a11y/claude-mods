diff -ruN a/src/commands/finish.mjs b/src/commands/finish.mjs
--- a/src/commands/finish.mjs	1969-12-31 16:00:00
+++ b/src/commands/finish.mjs	2026-11-18 21:35:49
@@ -0,0 +1,21 @@
+import { parseRating } from '../book.mjs'
+import { UsageError } from '../errors.mjs'
+
+// finish <start of the title> [--rating 1-5]
+export function finish(books, { flags, positional }, save) {
+  const start = positional.join(' ').trim()
+  if (start === '') throw new UsageError('finish needs the start of a title')
+  const rating = flags.rating === undefined ? undefined : parseRating(flags.rating)
+  const matches = books.filter((book) => book.title.toLowerCase().startsWith(start.toLowerCase()))
+  if (matches.length === 0) throw new UsageError(`no title starts with "${start}"`)
+  if (matches.length > 1) {
+    throw new UsageError(`"${start}" could be any of: ${matches.map((book) => book.title).join('; ')}`)
+  }
+  const [found] = matches
+  save(books.map((book) => {
+    if (book !== found) return book
+    const { tags, ...rest } = book
+    return { ...rest, status: 'done', ...(rating === undefined ? {} : { rating }), tags }
+  }))
+  return [`finished: ${found.title}`]
+}
