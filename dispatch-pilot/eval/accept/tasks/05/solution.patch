diff -ruN a/test/finish.test.mjs b/test/finish.test.mjs
--- a/test/finish.test.mjs	1969-12-31 16:00:00
+++ b/test/finish.test.mjs	2026-11-18 21:35:49
@@ -0,0 +1,32 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+
+import { BOOKS, run } from './helpers.mjs'
+
+test('finish marks the book whose title starts that way', () => {
+  const { code, books } = run(['finish', 'bir', '--rating', '4'])
+  assert.equal(code, 0)
+  assert.deepEqual(books[1], { title: 'Birch', author: 'Bo Barr', pages: 250, status: 'done', rating: 4, tags: [] })
+  assert.deepEqual([books[0], books[2]], [BOOKS[0], BOOKS[2]])
+})
+
+test('finish without a rating leaves the rating out', () => {
+  const { books } = run(['finish', 'CEDAR'])
+  assert.equal(books[2].status, 'done')
+  assert.equal('rating' in books[2], false)
+})
+
+test('finish refuses a start that fits no title, or several', () => {
+  const two = [...BOOKS, { title: 'Birdsong', author: 'Bea Bly', pages: 60, status: 'to-read', tags: [] }]
+  for (const [start, books] of [['zzz', BOOKS], ['bir', two], ['edar', BOOKS]]) {
+    const done = run(['finish', start], books)
+    assert.equal(done.code, 1)
+    assert.deepEqual(done.books, books)
+  }
+})
+
+test('finish refuses a rating outside 1 to 5', () => {
+  const { code, books } = run(['finish', 'birch', '--rating', '0'])
+  assert.equal(code, 1)
+  assert.deepEqual(books, BOOKS)
+})
